# Copy to .env.local and fill in.

# The deep-agent harness runs on Gemini by default (its free tier has a large
# per-minute token budget that fits the harness context). Get a key — no card —
# at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Fallback model. Set AGENT_PROVIDER=openrouter to run the agent on Nemotron
# instead of Gemini (e.g. if a Gemini quota is exhausted). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# AGENT_PROVIDER=openrouter

# Supabase — server-only. Never expose the service_role key to the browser.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Optional: ms between model call starts (default 6000).
# MODEL_MIN_INTERVAL_MS=6000
