# Copy to .env.local and fill in.

# The deep-agent harness runs on Kimi (Moonshot) by default — a paid,
# OpenAI-compatible endpoint. Get a key at https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=sk-...
# Optional overrides (defaults shown):
# KIMI_MODEL=kimi-k2.6     # or kimi-k2.5 / kimi-k2.7-code / kimi-k3 (check your account's model list)
# KIMI_BASE_URL=https://api.moonshot.ai/v1     # use https://api.moonshot.cn/v1 for the China platform

# Fallback models. Set AGENT_PROVIDER=openrouter or =gemini to run the agent on
# one of these instead of Kimi. Only needed if you keep a fallback configured.
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...
# AGENT_PROVIDER=openrouter

# Supabase — server-only. Never expose the service_role key to the browser.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Optional: ms between model call starts (default 6000).
# MODEL_MIN_INTERVAL_MS=6000
