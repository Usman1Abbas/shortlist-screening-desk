# Copy to .env.local and fill in.

# The agent runs on Gemini (primary — large per-minute token budget fits the long
# résumé prompts) and fails over to OpenRouter then Groq. Any one of the three
# lets the app run; all three give three independent free quotas for resilience.
GEMINI_API_KEY=...             # https://aistudio.google.com/apikey (no card)
OPENROUTER_API_KEY=sk-or-...   # https://openrouter.ai/keys (fallback)
GROQ_API_KEY=gsk_...           # https://console.groq.com/keys (fallback)

# Supabase — server-only. Never expose the service_role key to the browser.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Optional: ms between model call starts (default 8000, ~7.5 req/min).
# MODEL_MIN_INTERVAL_MS=8000
